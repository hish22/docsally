{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "exec-list-ollama-shell",
          "cmd": "powershell",
          "args": [
            "-Command",
            "ollama serve"
          ],
          "sidecar": false
        }
      ]
    },
    "dialog:default",
    "process:default"
  ]
}