{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-resource-read-recursive",
    "fs:allow-resource-write-recursive",
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{"path": "$APPDATA"},{"path": "$APPDATA/*"}]
    },
    {
      "identifier":"fs:scope",
      "allow": [    
      {"path": "$APPDATA"},
      {"path": "$APPDATA/*"},
      {"path": "$APPDATA/**"}]
    },
    { 
    "identifier": "fs:allow-exists",
    "allow": [{ "path": "$APPDATA/**" }]
  },
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "exec-list-ollama-shell",
          "cmd": "powershell",
          "args": [
            "-Command",
            "ollama serve"
          ],
          "sidecar": false
        }
      ]
    },
    "dialog:default",
    "process:default",
    "sql:default",
    "sql:allow-execute"
  ]
}